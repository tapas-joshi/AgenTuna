{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "quiet": {
      "command": "quiet-mcp",
      "args": [
        "--once",
        "--verbose"
      ],
      "enabled": false
    },
    "neighbour": {
      "type": "stdio",
      "command": "neighbour-mcp",
      "enabled": true
    }
  }
}
